* {
    font-family: "Segoe UI", "Inter", sans-serif;
    color: #E2E8F0;
}

QMainWindow {
    background-color: #0B1220;
}

/* ================= BARRA LATERAL ================= */
QFrame#sidebar {
    background-color: rgba(11, 18, 32, 0.72);
    border-right: 1px solid rgba(148, 163, 184, 0.14);
}

QLabel#sidebar-brand {
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 1.5px;
    color: #F8FAFC;
    background: transparent;
}

QLabel#sidebar-version {
    font-size: 10px;
    color: #64748B;
    background: transparent;
}

QPushButton#nav-button {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 10px;
    padding: 10px 12px;
    text-align: left;
    font-size: 12px;
    font-weight: 600;
    color: #94A3B8;
}

QPushButton#nav-button:hover {
    background-color: rgba(148, 163, 184, 0.10);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: #F1F5F9;
}

QPushButton#nav-button:checked {
    background-color: qlineargradient(
        x1:0, y1:0, x2:1, y2:1,
        stop:0 rgba(37, 99, 235, 0.92),
        stop:1 rgba(29, 78, 216, 0.85)
    );
    border: 1px solid rgba(147, 197, 253, 0.45);
    color: #FFFFFF;
}

/* ================= ENCABEZADO ================= */
QLabel#logo {
    font-size: 21px;
    font-weight: 800;
    letter-spacing: 1.8px;
    color: #F8FAFC;
    background: transparent;
}

QLabel#subtitle {
    font-size: 11px;
    color: #94A3B8;
    background: transparent;
}

QLabel#section {
    font-size: 13px;
    font-weight: 700;
    color: #F1F5F9;
    background: transparent;
}

QLabel#muted {
    font-size: 11px;
    color: #64748B;
    background: transparent;
}

QFrame#header-divider {
    background-color: rgba(148, 163, 184, 0.16);
    border: none;
}

/* ================= SELECTOR Y BOTONES HEADER ================= */
QComboBox#source-select {
    background-color: rgba(17, 24, 39, 0.78);
    border: 1px solid rgba(148, 163, 184, 0.24);
    border-radius: 9px;
    padding: 6px 12px;
    min-width: 155px;
    font-size: 12px;
    font-weight: 600;
    color: #E2E8F0;
}

QComboBox#source-select:hover {
    border: 1px solid rgba(56, 189, 248, 0.55);
}

QComboBox#source-select::drop-down {
    border: none;
    width: 24px;
}

QComboBox#source-select QAbstractItemView {
    background-color: #111827;
    border: 1px solid rgba(148, 163, 184, 0.25);
    border-radius: 8px;
    selection-background-color: #2563EB;
    selection-color: #FFFFFF;
    padding: 4px;
    outline: none;
}

QPushButton#audio-on {
    background-color: rgba(34, 197, 94, 0.14);
    border: 1px solid rgba(34, 197, 94, 0.48);
    border-radius: 9px;
    padding: 6px 12px;
    font-size: 11px;
    font-weight: 700;
    color: #4ADE80;
}

QPushButton#audio-on:hover {
    background-color: rgba(34, 197, 94, 0.24);
}

QPushButton#audio-off {
    background-color: rgba(100, 116, 139, 0.18);
    border: 1px solid rgba(148, 163, 184, 0.30);
    border-radius: 9px;
    padding: 6px 12px;
    font-size: 11px;
    font-weight: 700;
    color: #94A3B8;
}

QPushButton#audio-off:hover {
    background-color: rgba(100, 116, 139, 0.28);
}

QLabel#fps-label {
    background-color: rgba(17, 24, 39, 0.72);
    border: 1px solid rgba(148, 163, 184, 0.22);
    border-radius: 9px;
    padding: 6px 11px;
    font-size: 11px;
    font-weight: 700;
    color: #93C5FD;
    min-width: 68px;
}

QLabel#status-pill {
    background-color: rgba(34, 197, 94, 0.16);
    border: 1px solid rgba(34, 197, 94, 0.55);
    border-radius: 9px;
    padding: 6px 12px;
    font-size: 11px;
    font-weight: 700;
    color: #4ADE80;
}

/* ================= VISOR DE VIDEO ================= */
QLabel#camera-pill {
    background-color: rgba(34, 197, 94, 0.15);
    border: 1px solid rgba(34, 197, 94, 0.40);
    border-radius: 10px;
    padding: 4px 10px;
    font-size: 11px;
    font-weight: 700;
    color: #4ADE80;
}

QLabel#event-pill {
    background-color: rgba(15, 23, 42, 0.78);
    border: 1px solid rgba(148, 163, 184, 0.24);
    border-radius: 10px;
    padding: 4px 10px;
    font-size: 11px;
    font-weight: 700;
    color: #CBD5E1;
}

QFrame#video-frame {
    background-color: #050B14;
    border: 1px solid rgba(148, 163, 184, 0.18);
    border-radius: 11px;
}

QLabel#video {
    background-color: transparent;
    color: #64748B;
    font-size: 12px;
}

/* ================= OSCILOSCOPIO ================= */
QLabel#threshold-pill {
    background-color: rgba(239, 68, 68, 0.16);
    border: 1px solid rgba(239, 68, 68, 0.42);
    border-radius: 8px;
    padding: 4px 10px;
    font-size: 11px;
    font-weight: 700;
    color: #FCA5A5;
}

QFrame#status-banner {
    border-radius: 11px;
    background-color: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #22C55E,
        stop:1 #10B981
    );
}

QLabel#banner-title {
    font-size: 14px;
    font-weight: 800;
    color: #052014;
    background: transparent;
}

QLabel#banner-desc {
    font-size: 11px;
    font-weight: 600;
    color: #06281A;
    background: transparent;
}

/* ================= ESTADO DEL CONDUCTOR ================= */
QLabel#state-title {
    font-size: 24px;
    font-weight: 800;
    color: #22C55E;
    background: transparent;
}

QLabel#state-description {
    font-size: 11px;
    color: #94A3B8;
    background: transparent;
}

/* ================= TELEMETRÍA ================= */
QLabel#metric-title {
    font-size: 11px;
    font-weight: 600;
    color: #94A3B8;
    background: transparent;
}

QLabel#metric-value {
    font-size: 20px;
    font-weight: 800;
    color: #F8FAFC;
    background: transparent;
}

QLabel#metric-condition {
    font-size: 10px;
    font-weight: 600;
    color: #64748B;
    background: transparent;
}

QFrame#inner-separator {
    background-color: rgba(148, 163, 184, 0.14);
    border: none;
}

QLabel#fatigue-normal {
    background-color: rgba(34, 197, 94, 0.14);
    border: 1px solid rgba(34, 197, 94, 0.42);
    border-radius: 8px;
    padding: 3px 9px;
    font-size: 11px;
    font-weight: 700;
    color: #4ADE80;
}

QLabel#fatigue-warning {
    background-color: rgba(245, 158, 11, 0.18);
    border: 1px solid rgba(245, 158, 11, 0.55);
    border-radius: 8px;
    padding: 3px 9px;
    font-size: 11px;
    font-weight: 700;
    color: #FBBF24;
}

/* ================= CALIBRACIÓN ================= */
QPushButton#calibration-button {
    background-color: rgba(37, 99, 235, 0.24);
    border: 1px solid rgba(96, 165, 250, 0.50);
    border-radius: 8px;
    padding: 5px 11px;
    font-size: 11px;
    font-weight: 700;
    color: #DBEAFE;
}

QPushButton#calibration-button:hover {
    background-color: rgba(37, 99, 235, 0.42);
}

QPushButton#calibration-button:disabled {
    background-color: rgba(100, 116, 139, 0.20);
    border: 1px solid rgba(148, 163, 184, 0.22);
    color: #94A3B8;
}

QProgressBar#calibration-progress {
    background-color: rgba(15, 23, 42, 0.85);
    border: 1px solid rgba(148, 163, 184, 0.22);
    border-radius: 7px;
    height: 18px;
    text-align: center;
    font-size: 11px;
    font-weight: 700;
    color: #F8FAFC;
}

QProgressBar#calibration-progress::chunk {
    border-radius: 6px;
    background-color: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #2563EB,
        stop:1 #38BDF8
    );
}

/* ================= HISTORIAL DE INCIDENTES ================= */
QPushButton#link-button {
    background: transparent;
    border: none;
    color: #60A5FA;
    font-size: 11px;
    font-weight: 700;
    padding: 2px 6px;
}

QPushButton#link-button:hover {
    color: #93C5FD;
}

QPushButton#clear-button {
    background-color: rgba(100, 116, 139, 0.16);
    border: 1px solid rgba(148, 163, 184, 0.24);
    border-radius: 7px;
    padding: 3px 9px;
    font-size: 11px;
    font-weight: 600;
    color: #CBD5E1;
}

QPushButton#clear-button:hover {
    background-color: rgba(239, 68, 68, 0.20);
    border: 1px solid rgba(239, 68, 68, 0.45);
    color: #FCA5A5;
}

QListWidget#log-list {
    background-color: rgba(9, 14, 26, 0.55);
    border: 1px solid rgba(148, 163, 184, 0.14);
    border-radius: 9px;
    padding: 4px;
    font-size: 11px;
    outline: none;
}

QListWidget#log-list::item {
    padding: 5px 6px;
    border-radius: 6px;
    color: #CBD5E1;
}

QListWidget#log-list::item:hover {
    background-color: rgba(148, 163, 184, 0.10);
}

/* ================= SCROLLBARS ================= */
QScrollBar:vertical {
    background: transparent;
    width: 7px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: rgba(148, 163, 184, 0.30);
    border-radius: 3px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: rgba(148, 163, 184, 0.50);
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QLabel#placeholder-title {
    font-size: 20px;
    font-weight: 800;
    color: #F1F5F9;
    background: transparent;
}

QLabel#placeholder-desc {
    font-size: 13px;
    color: #94A3B8;
    background: transparent;
}
/* ================= PÁGINAS SECUNDARIAS (REPORTES / CONFIG / ACERCA DE) ================= */
QScrollArea#page-scroll {
    background: transparent;
    border: none;
}

QPushButton#secondary-button {
    background-color: rgba(148, 163, 184, 0.14);
    border: 1px solid rgba(148, 163, 184, 0.28);
    border-radius: 8px;
    padding: 5px 12px;
    font-size: 11px;
    font-weight: 600;
    color: #E2E8F0;
}

QPushButton#secondary-button:hover {
    background-color: rgba(148, 163, 184, 0.24);
}

QTableWidget#reports-table {
    background-color: rgba(9, 14, 26, 0.62);
    alternate-background-color: rgba(17, 24, 39, 0.68);
    border: 1px solid rgba(148, 163, 184, 0.16);
    border-radius: 10px;
    color: #E2E8F0;
    font-size: 12px;
    selection-background-color: rgba(37, 99, 235, 0.35);
    outline: none;
}

QTableWidget#reports-table::item {
    padding: 6px 10px;
}

QHeaderView::section {
    background-color: rgba(15, 23, 42, 0.92);
    color: #93C5FD;
    font-size: 11px;
    font-weight: 700;
    padding: 8px 10px;
    border: none;
    border-bottom: 1px solid rgba(148, 163, 184, 0.22);
}

QSpinBox#settings-spin,
QDoubleSpinBox#settings-spin {
    background-color: rgba(15, 23, 42, 0.85);
    border: 1px solid rgba(148, 163, 184, 0.26);
    border-radius: 8px;
    padding: 5px 10px;
    min-width: 110px;
    font-size: 12px;
    font-weight: 700;
    color: #F8FAFC;
}

QSpinBox#settings-spin:focus,
QDoubleSpinBox#settings-spin:focus {
    border: 1px solid #38BDF8;
}

QLabel#settings-value {
    font-size: 12px;
    font-weight: 700;
    color: #93C5FD;
    min-width: 135px;
    background: transparent;
}

QSlider::groove:horizontal {
    height: 6px;
    background: rgba(15, 23, 42, 0.90);
    border: 1px solid rgba(148, 163, 184, 0.24);
    border-radius: 3px;
}

QSlider::sub-page:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #2563EB, stop:1 #38BDF8);
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: #F8FAFC;
    border: 2px solid #38BDF8;
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 8px;
}